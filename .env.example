# ShineMonitor API credentials — copy to .env and fill in.
# .env is git-ignored. Never commit real credentials.

# Your ShineMonitor (KSolare portal) login — same as https://ksolare.shinemonitor.com/
SHINEMONITOR_USR=
SHINEMONITOR_PWD=

# KSolare manufacturer key (discovered from the public portal source — leave as is)
SHINEMONITOR_COMPANY_KEY=bnrl_frRFjEz8Mkn

# API base (leave as is unless ShineMonitor changes it)
SHINEMONITOR_API_BASE=http://api.shinemonitor.com/public/

# Optional: if you know your plant ID, put it here.
# If empty, the test script lists all plants on the account and uses the first one.
SHINEMONITOR_PLANT_ID=
